{
    "name": "s2j-webinar-survey-service",
    "version": "0.2.1",
    "description": "A pure PHP library for building a Webinar Survey (WP-Independent)",
    "type": "module",
    "author": "Koutarou ISHIKAWA",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stein2nd/s2j-webinar-survey-service.git"
    },
    "homepage": "https://github.com/stein2nd/s2j-webinar-survey-service#readme",
    "bugs": {
        "url": "https://github.com/stein2nd/s2j-webinar-survey-service/issues"
    },
    "keywords": [],
    "workspaces": [],
    "directories": {},
    "files": [],
    "main": "",
    "devDependencies": {
        "@s2j/docs-linter": "^1.0.31"
    },
    "scripts": {
        "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/**/*.md ./docs_mod/**/*.md",
        "lint:php": "composer lint:php",
        "phpstan": "composer phpstan",
        "phpcs": "composer phpcs",
        "generate": "./scripts/generate/all.zsh",
        "verify:codegen": "./scripts/generate/all.zsh && git diff --exit-code",
        "build:ts-client": "npm run build -w @s2j/similarity-client",
        "test:ts-client": "npm test -w @s2j/similarity-client",
        "test": "composer test",
        "validate:composer": "composer validate-composer",
        "verify:dist": "composer verify-dist",
        "quality": "zsh scripts/verify/all.zsh",
        "pretest:unit:php:local": "composer install --no-interaction --prefer-dist",
        "test:unit:php:local": "composer test",
        "pretest:lint:php": "composer install --no-interaction --prefer-dist"
    },
    "allowScripts": {
        "@s2j/docs-linter": true,
        "esbuild": true
    }
}
